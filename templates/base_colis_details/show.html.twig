{% extends 'base.html.twig' %}

{% block title %}BaseColisDetails{% endblock %}

{% block body %}
    <h1>BaseColisDetails</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ base_colis_detail.id }}</td>
            </tr>
            <tr>
                <th>TypeMarchandises</th>
                <td>{{ base_colis_detail.typeMarchandises }}</td>
            </tr>
            <tr>
