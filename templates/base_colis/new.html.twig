{% extends 'base.html.twig' %}

{% block title %}
  Hello ParametresController!
{% endblock %}
{% block stylesheets %}
  <link rel="stylesheet" type="text/css" href="{{ domaine }}/assets/css/colis.css" />
  <style>
    .select2-container {
      width: 100% !important;
    }
    
    .select2-container .select2-selection {
      width: 100% !important;
    }
    
    .form-group {
      width: 100%;
    }
    
    select {
      width: 100%;
    }
    
    /* Optionnel : Utilisation de Flexbox */
    .form-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
    }
    
    .form-group {
      flex: 1;
      margin: 5px;
    }
  </style>
{% endblock %}

{% block body %}
  <div class="page-wrapper">
    <!-- content -->
    <div class="content container-fluid">
      <div class="page-header">
        <div class="row">
          <div class="col-lg-7 col-md-12 col-sm-12 col-12">
            <h5 class="text-uppercase">Expédition</h5>
          </div>
          <div class="col-lg-5 col-md-12 col-sm-12 col-12">
            <ul class="list-inline breadcrumb float-right">
              <li class="list-inline-item">
                <a href="/">Accueil</a>
              </li>
              <li class="list-inline-item">Expédition</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="content-page p-4">
        <div class="alert"></div>
        <div class="row">
          <div class="col-md-8 offset-md-2">
            <h3 class="page-title">Ajouter un Nouveau Colis</h3>
            {{ form_start(form, { attr: { enctype: 'multipart/form-data' } }) }}
            <div class="form-group">
              <h3>Informations de l'expédition</h3>
              <label for="base_colis_expeditions">Expéditions</label>
              {{ form_widget(form.expeditions) }}
              <label for="base_colis_typeExpeditions">Type Expédition</label>
              {{ form_widget(form.typeExpeditions) }}

              <label for="base_colis_destinateurs">Envoyeur</label>
              {{ form_widget(form.clients) }}

              <label for="base_colis_destinateurs">Nom du destinataire</label>
              {{ form_widget(form.destinateursNom) }}

              <label for="base_colis_destinateurs">Téléphone du destinataire</label>
              {{ form_widget(form.destinateursTelephones) }}
            </div>

            <div id="colisContainer">
              <h3>Informations des Colis</h3>
              <div class="colis-group">
                <div class="form-group">
                  <label for="description">Type Marchandises</label>
                  <select id="base_colis_details_typeMarchandises" name="typeMarchandises[]" class="form-control select2">
                    <option value="">Choisir</option>
                    {% for typeMarchandise in typeMarchandises %}
                      <option value="{{ typeMarchandise.nom }}">{{ typeMarchandise.nom }}</option>
                    {% endfor %}
                  </select>
                </div>
                <div class="form-group">
                  <label for="poids">Couleur</label>
                  <input type="color" class="form-control" id="base_colis_details_poidsVolume" name="poidsVolume[]" required="required" />
                </div>
                <div class="form-group">
                  <label for="valeur">Prix (€)</label>
                  <input type="number" id="base_colis_details_prixPoidsVolume" name="prixPoidsVolume[]" required="required" />
                </div>
                <div class="form-group">
                  <label for="valeur">Observations</label>
                  <input type="text" id="base_colis_details_observations" name="observations[]" required="required" />
                </div>
                <div class="form-group">
                  <label for="valeur">Photo du colis</label>
                  <input type="file" id="base_colis_details_photos" name="photos[]" />
                </div>
                <button type="button" class="remove-colis">Supprimer ce colis</button>
              </div>
            </div>
            <button type="button" id="addColis">Ajouter un autre colis</button>
            <button type="submit">Enregistrer</button>
            {{ form_end(form) }}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

