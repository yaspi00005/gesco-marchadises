{% extends 'base.html.twig' %}

{% block title %}
  Stocks index
{% endblock %}
{% block stylesheets %}
  <link rel="stylesheet" type="text/css" href="{{ domaine }}/assets/css/dataTables.bootstrap4.min.css" />
  <style>/* Augmente la largeur du modal */
.custom-modal-width {
    max-width: 90%; /* Ajuste la largeur à 90% de l'écran */
    width: 90%;
}

/* Empêche le débordement du tableau */
.modal-body .table-responsive {
    max-height: 500px; /* Définit une hauteur maximale */
    overflow-y: auto;  /* Ajoute un défilement vertical si nécessaire */
}

/* Ajustement des cellules du tableau */
.modal-body table th, .modal-body table td {
    white-space: nowrap; /* Empêche les cellules de passer à la ligne */
    text-align: center; /* Centre le texte */
}
</style>
{% endblock %}
{% block body %}
  <div class="page-wrapper">
    <!-- content -->
    <div class="content container-fluid">
      <div class="page-header">
        <div class="row">
          <div class="col-lg-7 col-md-12 col-sm-12 col-12">
            <h5 class="text-uppercase">Gestion des Expéditions</h5>
          </div>
          <div class="col-lg-5 col-md-12 col-sm-12 col-12">
            <ul class="list-inline breadcrumb float-right">
              <li class="list-inline-item">
                <a href="/">Accueil</a>
              </li>
              <li class="list-inline-item">Expéditions</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-sm-4 col-3"></div>
      </div>
      <div class="content-page">
        <div class="row filter-row">
          <!-- Champ Code de Retrait -->
          <div class="col-sm-6 col-md-6">
            <div class="form-group custom-mt-form-group">
              <input type="text" id="codeRetrait" class="form-control" placeholder="Entrez le code de retrait" />
              <label class="control-label">Code de retrait</label><i class="bar"></i>
            </div>
          </div>

          <!-- Bouton de Recherche -->
          <div class="col-sm-6 col-md-3">
            <a href="#" class="btn btn-success btn-block mt-4 mb-2" id="chercherColis">Chercher</a>
          </div>
        </div>

        <!-- Résultats de la Recherche -->
        <div id="resultatColis" class="mt-4"></div>

        <div class="row">
          <div class="col-lg-12">
            <div class="table-responsive">
              <table class="table table-striped custom-table datatable">
                <thead>
                  <tr>
                    <th style="min-width:50px;">Numero Expeditions</th>
                    <th style="min-width:70px;">Mode Transport</th>
                    <th style="min-width:70px;">Destinations</th>
                    <th style="min-width:50px;">Date Expéditions</th>
                    <th style="min-width:70px;">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {% for expedition in Expeditions %}
                    <tr>
                      <td>EX-{{ expedition.numeroExpeditions }}</td>
                      <td>{{ expedition.modeTransport }}</td>
                      <td>{{ expedition.destinations }}</td>
                      <td>{{ expedition.dateExpeditions ? expedition.dateExpeditions|date('Y-m-d') : '' }}</td>
                      <td>
                        <a href="{{ path('app_base_colis_liste', { expedition: expedition.numeroExpeditions }) }}">Détail</a>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
  
</div>

      </div>
    </div>
  </div>

  <!-- Modal pour afficher les détails du colis -->
<!-- Modal pour afficher les détails du colis -->
<div class="modal fade" id="colisDetailsModal" tabindex="-1" role="dialog" aria-labelledby="colisDetailsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl custom-modal-width" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="colisDetailsModalLabel">Détails du Colis</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <!-- Conteneur pour éviter le débordement -->
        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
              <tr>
                <th>Numéro de colis</th>
                <th>Code de retrait</th>
                <th>Type d'Expédition</th>
                <th>Unité</th>
                <th>Frais d’expédition</th>
                <th>État du colis</th>
                <th>Paiement</th>
                <th>Remise</th>
                <th>Montant restant</th>
                <th>Date de réception</th>
                <th>Expéditeur</th>
                <th>Expédition</th>
              </tr>
            </thead>
            <tbody id="modalColisDetails"></tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>


{% endblock %}
{% block javascripts %}
  <script type="text/javascript" src="{{ domaine }}/assets/js/traitements.js"></script>
  <script type="text/javascript" src="{{ domaine }}/assets/js/jquery.dataTables.min.js"></script>
  <script type="text/javascript" src="{{ domaine }}/assets/js/dataTables.bootstrap4.min.js"></script>
  <script>
document.addEventListener("DOMContentLoaded", function () {
    document.getElementById("chercherColis").addEventListener("click", function (e) {
        e.preventDefault();

        const codeRetrait = document.getElementById("codeRetrait").value.trim();
        
        if (codeRetrait === "") {
            alert("Veuillez entrer un code de retrait.");
            return;
        }

        fetch(`/pays/base/colis/recherche/${codeRetrait}`, {
            method: "GET",
            headers: {
                "X-Requested-With": "XMLHttpRequest"
            }
        })
        .then(response => response.json())
        .then(data => {
            const modalBody = document.getElementById("modalColisDetails");
            modalBody.innerHTML = "";

            if (data.error) {
                modalBody.innerHTML = `<tr><td colspan="12" class="text-danger">${data.error}</td></tr>`;
            } else {
                let newRow = `
                    <tr>
                        <td>${data.numeroSuivi}</td>
                        <td>${data.codeRetrait}</td>
                        <td>${data.typeExpeditions}</td>
                        <td>${data.unites}</td>
                        <td>${data.fraisExpeditions} €</td>
                        <td><span class="badge ${getStatusClass(data.statut)}">${data.statut}</span></td>
                        <td>${data.statutPaiements}</td>
                        <td>${data.remises} €</td>
                        <td>${data.montantRestant} €</td>
                        <td>${data.dateReceptions}</td>
                        <td>${data.clients.prenom} ${data.clients.nom}</td>
                        <td>${data.expeditions.destinations} - ${data.expeditions.dateExpeditions}</td>
                    </tr>
                `;
                modalBody.insertAdjacentHTML("beforeend", newRow);

                // Afficher le modal après la recherche
                $("#colisDetailsModal").modal("show");
            }
        })
        .catch(error => {
            console.error("Erreur lors de la recherche :", error);
            document.getElementById("modalColisDetails").innerHTML = `<tr><td colspan="12" class="text-danger">Erreur lors du chargement des détails.</td></tr>`;
        });
    });
});

// Fonction pour ajouter des couleurs aux statuts
function getStatusClass(statut) {
    switch (statut) {
        case "En Préparation": return "badge-warning";
        case "Expédié": return "badge-primary";
        case "Livré": return "badge-success";
        case "Annulé": return "badge-danger";
        default: return "badge-secondary";
    }
}


  </script>
{% endblock %}
