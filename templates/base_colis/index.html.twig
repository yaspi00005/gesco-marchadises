{% extends 'base.html.twig' %}

{% block title %}
  Stocks index
{% endblock %}
{% block stylesheets %}
  <link rel="stylesheet" type="text/css" href="{{ domaine }}/assets/css/dataTables.bootstrap4.min.css" />
{% endblock %}
{% block body %}
  <div class="page-wrapper">
    <!-- content -->
    <div class="content container-fluid">
      <div class="page-header">
        <div class="row">
          <div class="col-lg-7 col-md-12 col-sm-12 col-12">
            <h5 class="text-uppercase">Gestion des colis</h5>
          </div>
          <div class="col-lg-5 col-md-12 col-sm-12 col-12">
            <ul class="list-inline breadcrumb float-right">
              <li class="list-inline-item">
                <a href="/">Accueil</a>
              </li>
              <li class="list-inline-item">
                <a href="">Journal des ventes</a>
              </li>
              <li class="list-inline-item">Journal des ventes détails</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-sm-4 col-3"></div>
      </div>
      <div class="content-page">
        <div class="row filter-row">
          <div class="col-sm-6 col-md-3">
            <div class="form-group custom-mt-form-group">
              <input type="text" id="num_suivi" />
              <label class="control-label">Numéro de suivi</label><i class="bar"></i>
            </div>
          </div>
          <div class="col-sm-6 col-md-3">
            <div class="form-group custom-mt-form-group">
              <input type="date" value="null" id="date" />
              <label class="control-label">Date</label><i class="bar"></i>
            </div>
          </div>

          <div class="col-sm-6 col-md-3">
            <div class="form-group custom-mt-form-group">
              <select id="">
                <option value="Tous">Tous</option>
                <option value="En préparation">En préparation</option>
                <option value="Expédié">Expédié</option>
                <option value="En transit">En transit</option>
                <option value="Arrivé">Arrivé</option>
                <option value="Livré">Livré</option>
                <option value="Retenu en douane">Retenu en douane</option>
              </select>
              <label class="control-label">Statut</label><i class="bar"></i>
            </div>
          </div>

          <div class="col-sm-6 col-md-3">
            <a href="#" class="btn btn-success btn-block mt-4 mb-2 charger" data-type="details">Charger</a>
          </div>
        </div>
        <div class="row">
          <div class="col-lg-12">
            <div class="table-responsive">
              <table class="table table-striped m-b-0 datatable">
                <div class="col-sm-12 col-12 text-right m-b-20">
                  <div class="view-icons">
                    <a href="-" class="list-view btn btn-link active"><i class="fas fa-bars"></i></a>
                  </div>
                </div>
                <thead>
                  <tr>
                    <th>Numéro de suivi</th>
                    <th>Type d'Expédition</th>
                    <th>Poids/volume du colis</th>
                    <th>Unité</th>
                    <th>Frais d’expédition</th>
                    <th>État du colis</th>
                    <th>Paiement</th>
                    <th>Date de réception</th>
                    <th>Date de Récuperation</th>
                    <th>Destinateur</th>
                    <th>Expédition</th>
                    <th>Voix</th>
                  </tr>
                </thead>
                <tbody class="journal">
                  {% for base_coli in base_colis %}
                    <tr>
                      <td class="text-left">{{ base_coli.numeroSuivi }}</td>
                      <td class="text-left">{{ base_coli.typeExpeditions }}</td>
                      <td class="text-left">{{ base_coli.poidsVolumeTotal }}</td>
                      <td class="text-left">{{ base_coli.unites }}</td>
                      <td class="text-left">{{ base_coli.fraisExpeditions|number_format(0, '.', ',') }}</td>
                      <td class="text-right">
                        <a class="btn btn-sm btn-rounded 
                            {% if base_coli.statut == 'En Préparation' %}

                          {% elseif base_coli.statut == 'Expédié' %}

                          {% elseif base_coli.statut == 'Livré' %}

                          {% elseif base_coli.statut == 'Annulé' %}

                          {% endif %}"
                          href="#">
                          {{ base_coli.statut }}
                        </a>
                      </td>
                      <td>
                        {{ base_coli.statutPaiements }}
                        {% if base_coli.statutPaiements == 'Non payé' %}
                          <button class="btn btn-primary btn-sm encaisser-btn" data-id="{{ base_coli.id }}">Encaisser</button>
                        {% endif %}
                      </td>
                      <td>{{ base_coli.dateReceptions ? base_coli.dateReceptions|date('d-m-Y') }}</td>
                      <td>{{ base_coli.dateRecuperations ? base_coli.dateRecuperations|date('d-m-Y') }}</td>
                      <td>{{ base_coli.destinateurs.prenom ~ ' ' ~ base_coli.destinateurs.nom }}</td>
                      <td>
                        <a href="#">{{ base_coli.expeditions.numeroExpeditions }}</a>
                      </td>
                      <td>{{ base_coli.expeditions.modeTransport }}</td>
                    </tr>
                  {% else %}
                    <tr>
                      <td colspan="11">no records found</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div id="details-modal" class="modal">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h3 class="modal-title">Détails de la commande</h3>
          <button type="button" class="close" data-dismiss="modal">&times;</button>
        </div>
        <div class="modal-body">
          <i class="fa fa-print"></i>
          <table class="table table-striped m-b-0">
            <thead>
              <tr>
                <th>Avance payé</th>
                <th>Rémise</th>
                <th>Total</th>
                <th>Caissier</th>
                <th>Statut</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody class="details"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
{% block javascripts %}
  <script type="text/javascript" src="{{ domaine }}/assets/js/base-colis.js"></script>
  <script type="text/javascript" src="{{ domaine }}/assets/js/jquery.dataTables.min.js"></script>
  <script type="text/javascript" src="{{ domaine }}/assets/js/dataTables.bootstrap4.min.js"></script>
{% endblock %}
