{% extends 'base.html.twig' %}

{% block title %}
  Détails de l'Expédition
{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" type="text/css" href="{{ domaine }}/assets/css/colis.css" />
{% endblock %}

{% block body %}
  <div class="page-wrapper">
    <script>
      document.addEventListener("DOMContentLoaded", function () {
          const colisId = "{{ colis }}"; // ID du colis à récupérer

          if (colisId) {
              fetch(`/ramassages/colis/details/${colisId}/ajax`)
                  .then(response => response.json())
                  .then(data => {
                      const detailsContent = document.getElementById("detailsContent");

                      if (data && data.numeroSuivi) {
                          detailsContent.innerHTML = `
                              <h5>Numéro de Colis : ${data.numeroSuivi}</h5>
                              <p><strong>Code de Retrait :</strong> <span class="badge bg-info">${data.codeRetrait}</span></p>
                              <p><strong>Destinateur :</strong> ${data.expediteur}</p>
                              <p><strong>Téléphone :</strong> ${data.telephone}</p>
                              <p><strong>Poids :</strong> ${data.poids} kg</p>
                              <p><strong>Prix :</strong> ${data.prix} €</p>
                              <p><strong>Total :</strong> <span class="text-success">${data.prix * data.poids} €</span></p>
                              <p><strong>Type d'Expédition :</strong> ${data.TypeExpedition}</p>
                              <p><strong>Date de Réception :</strong> ${data.dateReception}</p>
                              <div class="qr-code text-center">
                                  <img src="/uploads/${data.qrCodePath}" alt="QR Code" class="img-thumbnail" style="max-width: 200px;">
                              </div>
                          `;
                      } else {
                          detailsContent.innerHTML = "<p class='text-danger'>Erreur : Impossible de charger les détails du colis.</p>";
                      }
                  })
                  .catch(error => {
                      console.error("Erreur lors du chargement des détails :", error);
                      document.getElementById("detailsContent").innerHTML = "<p class='text-danger'>Erreur lors du chargement des détails.</p>";
                  });
          }
      });

      function printReceipt() {
          const printWindow = window.open("", "PRINT", "height=600,width=800");
          const detailsContent = document.getElementById("detailsContent").innerHTML;

          printWindow.document.write(`
              <html>
                  <head>
                      <title>Reçu</title>
                      <style>
                          body { font-family: Arial, sans-serif; font-size: 12px; }
                          img { max-width: 100px; }
                          .qr-code { text-align: center; margin: 10px 0; }
                      </style>
                  </head>
                  <body>
                      <h1>SOTRAMA</h1>
                      <h3>Reçu du Colis</h3>
                      ${detailsContent}
                  </body>
              </html>
          `);

          printWindow.document.close();
          printWindow.focus();
          printWindow.print();
          printWindow.close();
      }
    </script>

    <!-- Content -->
    <div class="content container-fluid">
      <div class="page-header">
        <div class="row">
          <div class="col-lg-7 col-md-12 col-sm-12 col-12">
            <h5 class="text-uppercase">Reçu</h5>
          </div>
          <div class="col-lg-5 col-md-12 col-sm-12 col-12">
            <ul class="list-inline breadcrumb float-right">
              <li class="list-inline-item"><a href="/">Accueil</a></li>
              <li class="list-inline-item">Reçu</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="content-page p-4">
       {% include "alert.html.twig" %}

        <div class="alert"></div>

        <!-- Section pour afficher les détails -->
        <div id="detailsContent" class="mt-4 text-center">

          <div class="spinner-border" role="status">
            <span class="visually-hidden">Chargement...</span>
          </div>
        </div>

        <!-- Bouton pour imprimer -->
        {% if paiements.montantPaye == 0 and paiements.remises == 0 %}
            <button class="btn btn-primary btn-sm encaisser-btn encaisser-btn-recu" data-sahel="{{ sahel }}"  data-montant="{{ paiements.fraisExpeditions }}" data-id="{{ paiements.id }}">Encaisser</button>
        {% endif %}
       <button class="btn btn-warning mt-3">        <a href="{{ path('generate_pdf', { 'colisId': colis}) }}" class="btn btn-warning btn-sm ">Exporter en PDF</a>
</button> 
        {# <button class="btn btn-success mt-3" onclick="printReceipt()">Imprimer le reçu</button> #}
      </div>
    </div>
  </div>
    <div class="modal fade" id="paiementModal" tabindex="-1" role="dialog" aria-labelledby="paiementModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="paiementModalLabel">Encaisser un Paiement</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body">
          <form id="paiementForm">
            <input type="hidden" id="colisId" name="colisId" />

            <!-- Montant Total -->
            <div class="form-group">
              <label>Montant Total :</label>
              <input type="text" class="form-control" id="montantTotal" readonly />
            </div>

            <!-- Montant Déjà Payé -->
            <div class="form-group">
              <label>Montant Déjà Payé :</label>
              <input type="text" class="form-control" id="montantDejaPaye" readonly />
            </div>

            <!-- Remise -->
            <div class="form-group">
              <label>Remise (€)</label>
              <input type="text" class="form-control" id="remise" name="remise" min="0" value="0" />
            </div>

            <!-- Montant Restant -->
            <div class="form-group">
              <label>Montant Restant :</label>
              <input type="text" class="form-control" id="montantRestant" readonly />
            </div>

            <div class="form-group">
              <label>Point Sahel  Disponible :</label>
              <input type="text" class="form-control"  value ="{{ sahel  }}"  id="sahel" readonly />
            </div>
             <div class="form-group">
              <label>Appliquer la remise :</label>
              <input type="checkbox" class="form-control" id="SahelAppliquer"   />
            </div>

            <!-- Type de Paiement -->
            <div class="form-group">
              <label>Type de Paiement :</label>
              <select class="form-control" id="typePaiement" required>
                <option value="total">Paiement Total</option>
                <option value="partiel">Paiement Partiel</option>
              </select>
            </div>

            <!-- Montant Partiel -->
            <div class="form-group" id="montantPartielDiv" style="display: none;">
              <label>Montant Payé :</label>
              <input type="number" class="form-control" id="montantPartiel" step="0.01" />
            </div>

            <button type="submit" class="btn btn-primary">Encaisser</button>
          </form>
        </div>
      </div>
    </div>
  </div>

{% endblock %}

{% block javascripts %}
   <script type="text/javascript" src="{{ domaine }}/assets/js/recus.js"></script>
   <script type="text/javascript" src="{{ domaine }}/assets/js/base-colis.js"></script>

   <script>
  function appliquerSahel() {
    const isChecked = $('#SahelAppliquer').is(':checked');
    const sahelValue = ($('#sahel').val() || '0').toString().trim();

    if (isChecked) {
      $('#remise').val(sahelValue).prop('readonly', true);
    } else {
      $('#remise').val(0).prop('readonly', false);
    }
  }

  $(document).ready(function () {
    // au chargement
    appliquerSahel();

    // au clic sur la checkbox
    $('#SahelAppliquer').on('change', appliquerSahel);
  });
</script>
{% endblock %}
