<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0" />
    <link rel="shortcut icon" type="image/x-icon" href="{{ domaine }}/assets/img/logo.png" />
    <title>
      {% if app.request.cookies.get('nom') %}
        {{ app.request.cookies.get('nom') }}
      {% else %}
        Sotrama
      {% endif %}
    </title>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700,900" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="{{ domaine }}/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="{{ domaine }}/assets/plugins/fontawesome/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="{{ domaine }}/assets/plugins/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" type="text/css" href="{{ domaine }}/assets/css/select2.min.css" />
    <link rel="stylesheet" type="text/css" href="{{ domaine }}/assets/css/bootstrap-datetimepicker.min.css" />
    {% block stylesheets %}

    {% endblock %}
    <link rel="stylesheet" type="text/css" href="{{ domaine }}/assets/css/style.css" />
   
  </head>

  <body>
    <div class="main-wrapper">
      <div class="header">
        <!-- Header start -->
        <div class="header-left">
          <a href="/" class="logo">
            <img src="{{ domaine }}/assets/img/logo.png" width="40" height="40" alt="" />
            <span class="text-uppercase">Sotrama</span>
          </a>
        </div>
        <div class="page-title-box float-left">
          <h3 class="text-uppercase">Sotrama</h3>
        </div>
        <a id="mobile_btn" class="mobile_btn float-left" href="#sidebar"><i class="fas fa-bars" aria-hidden="true"></i></a>
        <ul class="nav user-menu float-right">
          <li class="nav-item dropdown d-none d-sm-block">
            <a href="#" class="dropdown-toggle nav-link" data-toggle="dropdown"><i class="fas fa-bell"></i> <span class="badge badge-pill bg-primary float-right">0</span></a>
            <div class="dropdown-menu notifications">
              <div class="topnav-dropdown-header">
                <span>Notifications</span>
              </div>
              <div class="drop-scroll">
                <ul class="notification-list">
                  {# {% for notif in notifs %}
                                <li class="notification-message">
                                    <a href="activities.html">
                                        <div class="media">
											<span class="avatar">
												<img alt="" src="{{domaine}}/assets/img/user.jpg" class="img-fluid rounded-circle">
											</span>
											<div class="media-body">
												<p class="noti-details"><span class="noti-title">Alert</span> 0 </p>
												<p class="noti-time"><span class="notification-time">0</span></p>
											</div>
                                        </div>
                                    </a>
                                </li>
                            {% endfor %} #}
                </ul>
              </div>
              <div class="topnav-dropdown-footer">
                <a href="">Voir</a>
              </div>
            </div>
          </li>

          <li class="nav-item dropdown has-arrow">
            <a href="#" class="dropdown-toggle nav-link user-link" data-toggle="dropdown">
              <span class="user-img">
                <img class="rounded-circle" src="{{ domaine }}/assets/img/user.jpg" width="40" alt="Admin" />
                <span class="status online"></span>
              </span>
              {# <span>{{ app.user.prenom }}</span> #}
            </a>
            <div class="dropdown-menu">
              {# <a class="dropdown-item" href="{{ path('app_reset') }}">Changer de mot de passe</a> #}
              <a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a>
            </div>
          </li>
        </ul>
        <div class="dropdown mobile-user-menu float-right">
          <!-- mobile menu -->
          <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
          <div class="dropdown-menu dropdown-menu-right">
            {# <a class="dropdown-item" href="{{ path('app_reset') }}">Changer de mot de passe</a> #}
            <a class="dropdown-item" href="{{ path('app_logout') }}">Déconnexion</a>
          </div>
        </div>
      </div>
      <div class="sidebar" id="sidebar">
        <!-- sidebar -->
        <div class="sidebar-inner slimscroll">
          <div id="sidebar-menu" class="sidebar-menu">
            <ul>
              <li class="menu-title">Main</li>

              {% if is_granted('ROLE_RAMASSAGE') %}
                <li>
                  <a href="{{ path('app_base_colis_new') }}"><i class="fas fa-box" aria-hidden="true"></i>Nouveau colis</a>
                </li>
                <li>
                  <a href="{{ path('app_clients_new') }}"><i class="fas fa-user" aria-hidden="true"></i>Ajouter un client</a>
                </li>
                <li>
                  <a href="{{ path('app_base_colis_index_rama') }}"><i class="fas fa-box" aria-hidden="true"></i>Mes ramassages</a>
                </li>
                <li>
                  <a href="{{ path('app_programmes') }}"><i class="fas fa-calendar" aria-hidden="true"></i>Progammes</a>
                </li>
              {% endif %}

              {% if is_granted('ROLE_ADMIN') %}
                <li>
                  <a href="/"><i class="fas fa-tachometer-alt" aria-hidden="true"></i> Dashboard</a>
                </li>
                <li class="submenu">
                  <a href="javascript:void(0);" class="noti-dot"><i class="fas fa-rocket" aria-hidden="true"></i> <span>Management</span> <span class="menu-arrow"></span></a>
                  <ul style="display: none;">
                    <li>
                      <a href="{{ path('app_paiements_index') }}"></i>Paiements</a>
                    </li>
                    <li>
                      <a href="{{ path('app_expeditions_index') }}">Gestion des expédition</a>
                    </li>
                    <li>
                      <a href="{{ path('app_admin') }}">Clients</a>
                    </li>
                    <li>
                      <a href="{{ path('app_register') }}">Utilisateurs</a>
                    </li>
                  </ul>
                </li>
              {% endif %}

              {% if is_granted('ROLE_REPRESENTANT') %}
                <li>
                  <a href="{{ path('app_base_colis_index') }}"><i class="fas fa-box" aria-hidden="true"></i>Arrivages</a>
                </li>
              {% endif %}
            </ul>
          </div>
        </div>
      </div>
      {% block body %}

      {% endblock %}
    </div>
    <div class="sidebar-overlay" data-reff=""></div>
    <script type="text/javascript" src="{{ domaine }}/assets/js/jquery-3.5.1.min.js"></script>
    <script type="text/javascript" src="{{ domaine }}/assets/js/popper.min.js"></script>
    <script type="text/javascript" src="{{ domaine }}/assets/js/bootstrap.min.js"></script>
    <script type="text/javascript" src="{{ domaine }}/assets/js/jquery.slimscroll.js"></script>
    <script type="text/javascript" src="{{ domaine }}/assets/js/select2.min.js"></script>
    <script type="text/javascript" src="{{ domaine }}/assets/js/moment.min.js"></script>
    <script type="text/javascript" src="{{ domaine }}/assets/js/bootstrap-datetimepicker.min.js"></script>
    {% block javascripts %}

    {% endblock %}
    <script type="text/javascript" src="{{ domaine }}/assets/js/app.js"></script>
  </body>
</html>
