{% extends 'base.html.twig' %}

{% block title %}Expeditions{% endblock %}

{% block body %}
    <h1>Expeditions</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ expedition.id }}</td>
            </tr>
            <tr>
                <th>ModeTransport</th>
                <td>{{ expedition.modeTransport }}</td>
            </tr>
            <tr>
                <th>NumeroExpeditions</th>
                <td>{{ expedition.numeroExpeditions }}</td>
            </tr>
            <tr>
                <th>Depart</th>
                <td>{{ expedition.depart }}</td>
            </tr>
            <tr>
                <th>Destinations</th>
                <td>{{ expedition.destinations }}</td>
            </tr>
            <tr>
                <th>DateExpeditions</th>
                <td>{{ expedition.dateExpeditions ? expedition.dateExpeditions|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>DateArrive</th>
                <td>{{ expedition.dateArrive ? expedition.dateArrive|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_expeditions_index') }}">back to list</a>

    <a href="{{ path('app_expeditions_edit', {'id': expedition.id}) }}">edit</a>

    {{ include('expeditions/_delete_form.html.twig') }}
{% endblock %}
