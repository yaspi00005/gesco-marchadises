<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <title>Reçu du Colis</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        font-size: 14px;
      }
      h1 {
        text-align: center;
        color: #333;
      }
      .header {
        text-align: center;
        margin-bottom: 10px;
      }
      .header img {
        max-width: 70px;
        margin-bottom: 10px;
      }
      .details {
        text-align: left;
        margin: 20px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
      }
      th,
      td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: center;
      }
      th {
        background-color: #f4f4f4;
        font-weight: bold;
      }
      .qr-code,
      .colis-image {
        text-align: center;
        margin-top: 10px;
      }
      
      /* ✅ Affichage des photos en 2 colonnes */
      .colis-image-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr); /* 2 colonnes */
        gap: 10px;
        margin-top: 15px;
      }
      .colis-image-container img {
        width: 100%;
        max-width: 250px;
        height: auto;
        object-fit: cover;
        border: 1px solid #ddd;
      }
      
      /* Style du message de remerciement */
      .thanks-message {
        text-align: center;
        font-size: 16px;
        margin-top: 20px;
        font-weight: bold;
        color: rgb(14, 236, 40);
        border-top: 2px solid #ddd;
        padding-top: 15px;
      }
    </style>
  </head>
  <body>
    <div class="header">
      {% if logoBase64 %}
        <img src="data:image/png;base64,{{ logoBase64 }}" alt="Logo sotrama" />
        <h2>Sotrama</h2>
        <p>Expédition des colis au Mali et au Sénégal</p>
      {% endif %}
      <h1>Reçu du Colis</h1>
    </div>

    <div class="details">
      <p>
        <strong>Numéro de suivi :</strong> {{ colis.numeroSuivi }}
      </p>
      <p>
        <strong>Code de retrait :</strong> {{ colis.code }}
      </p>
      <p>
        <strong>Expéditeur :</strong> {{ colis.clients.prenom ~ ' ' ~ colis.clients.nom ~ ' ' ~ colis.clients.telephone }}
      </p>
      <p>
        <strong>Destinataire :</strong> {{ colis.destinateursNom ~ ' ' ~ colis.destinateursTelephones }}
      </p>
      <p>
        <strong>Nombre de colis expédié :</strong> {{ colis.unites }}
      </p>
      <p>
        <strong>Frais d'expédition :</strong> {{ colis.fraisExpeditions }}€
      </p>
      <p>
        <strong>Montant payé :</strong> {{ colis.montantPaye }} €
      </p>
      {% if colis.remises != 0 %}
        <p>
          <strong>Remise accordée :</strong> {{  colis.remises }} €
        </p>
      {% endif %}
      <p>
        <strong>Montant restant :</strong> {{ colis.fraisExpeditions - colis.montantPaye - colis.remises }} €
      </p>
      <p>
        <strong>Date de réception :</strong> {{ colis.dateReceptions|date('d/m/Y') }}
      </p>
      <p>
        <strong>Chauffeur :</strong> {{ colis.expediteurs.prenom ~ ' ' ~ colis.expediteurs.nom }}
      </p>
    </div>

    <div class="colis-image">
      <h3>Photos du Colis</h3>
      <div class="colis-image-container">
        {% for photosData in photosData %}
          <img src="data:image/jpeg;base64,{{ photosData.photoBase64 }}" alt="Photo du Colis" />
          <p>{{ photosData.observation }}</p>
        {% else %}
          <p>Aucune photo disponible</p>
        {% endfor %}
      </div>
    </div>

    <!-- Ajout du message de remerciement -->
    <div class="thanks-message">
      <p>
        Merci d'avoir choisi <strong>Sotrama</strong> pour l'expédition de votre colis !
      </p>
      <p>Nous espérons vous revoir bientôt. </p>
    </div>
  </body>
</html>
