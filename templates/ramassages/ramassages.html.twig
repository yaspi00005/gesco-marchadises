{% extends 'base.html.twig' %}

{% block title %}
  Stocks index
{% endblock %}
{% block stylesheets %}
  <link rel="stylesheet" type="text/css" href="{{ domaine }}/assets/css/dataTables.bootstrap4.min.css" />
  <style>
    .select2-container {
      width: 100% !important;
    }
    
    .select2-container .select2-selection {
      width: 100% !important;
    }
    
    .form-group {
      width: 100%;
    }
    
    select {
      width: 100%;
    }
    
    /* Optionnel : Utilisation de Flexbox */
    .form-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
    }
    
    .form-group {
      flex: 1;
      margin: 5px;
    }
  </style>
{% endblock %}
{% block body %}
  <div class="page-wrapper">
    <!-- content -->
    <div class="content container-fluid">
      <div class="page-header">
        <div class="row">
          <div class="col-lg-7 col-md-12 col-sm-12 col-12">
            <h5 class="text-uppercase">Mes ramassages</h5>
          </div>
          <div class="col-lg-5 col-md-12 col-sm-12 col-12">
            <ul class="list-inline breadcrumb float-right">
              <li class="list-inline-item">
                <a href="/">Accueil</a>
              </li>

              <li class="list-inline-item">Ramassages</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-sm-4 col-3"></div>
      </div>
      <div class="content-page">
        <div class="row">
          <div class="col-lg-12">
            <div class="table-responsive">
              <table class="table table-striped m-b-0 datatable">
                <div class="col-sm-12 col-12 text-right m-b-20"></div>
                <thead>
                  <tr>
                    <th>Numéro de colis</th>
                    <th>Code de retrait</th>
                    <th>Type d'Expédition</th>
                    <th>Unité</th>
                    <th>Frais d’expédition</th>
                    <th>État du colis</th>
                    <th>Paiement</th>
                    <th>Remise</th>
                    <th>Montant restant</th>
                    <th>Date de réception</th>
                    <th>Expéditeur</th>
                   {#  <th>Expédition</th> #}
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody class="journal">
                  {% for base_coli in base_colis %}
                    <tr>
                      <td class="text-left">
                        <a href="{{ path('colis_details_clt', { url: base_coli.url }) }}">{{ base_coli.numeroSuivi }}</a>
                      </td>
                      <td class="text-left">{{ base_coli.code }}</td>
                      <td class="text-left">{{ base_coli.typeExpeditions }}</td>
                      <td class="text-left">{{ base_coli.unites }}</td>
                      <td class="text-left">{{ base_coli.fraisExpeditions|number_format(0, '.', ',') }}</td>
                      <td class="text-right">
                        <a class="btn btn-sm btn-rounded 
          {% if base_coli.statut == 'En Préparation' %}

                          {% elseif base_coli.statut == 'Expédié' %}

                          {% elseif base_coli.statut == 'Livré' %}

                          {% elseif base_coli.statut == 'Annulé' %}

                          {% endif %}"
                          href="#">
                          {{ base_coli.statut }}
                        </a>
                      </td>
                      <td>
                        {{ base_coli.statutPaiements }}
                        {% if base_coli.statutPaiements == 'Non payé' %}
                          <button class="btn btn-primary btn-sm encaisser-btn" data-montant="{{ base_coli.fraisExpeditions }}" data-id="{{ base_coli.id }}">Encaisser</button>
                        {% else %}
                          <br /> <button class="btn btn-danger btn-sm delete-paiement" data-id="{{ base_coli.url }}"><i class="fas fa-trash"></i></button>
                        {% endif %}
                      </td>
                      <td>{{ base_coli.remises|number_format(0, '.', ',') }}</td>
                      <td>{{ (base_coli.fraisExpeditions - base_coli.montantPaye - base_coli.remises)|number_format(0, '.', ',') }}</td>
                      <td>{{ base_coli.dateReceptions ? base_coli.dateReceptions|date('d-m-Y') }}</td>
                      <td>{{ base_coli.clients.prenom ~ ' ' ~ base_coli.clients.nom }}</td>
                     {#  <td>
                        <a href="#">{{ base_coli.expeditions.destinations ~ '-' }}{{ base_coli.expeditions.dateExpeditions ? base_coli.expeditions.dateExpeditions|date('d-m-Y') : '' }}</a>
                      </td> #}
                      <td style="width:30%">
                        <button title="Ajouter un article" class="btn btn-primary btn-sm add-article-btn" data-url="{{ base_coli.url }}" data-numero-colis="{{ base_coli.numeroSuivi }}"><i class="fas fa-plus"></i></button>

                        {% if base_coli.statut == 'En préparation' %}
                          <button title="Suprimer" class="btn btn-danger btn-sm delete-colis-btn" data-id="{{ base_coli.url }}"><i class="fas fa-trash"></i></button>
                        {% endif %}
                        <a href="{{  path('generate_pdf',{'colisId': base_coli.numeroSuivi})  }}" title="Reçu" class="btn btn-primary btn-sm"><i class="fas fa-file-invoice"></i></a>
                      </td>
                    </tr>
                  {% else %}
                    <tr>
                      <td colspan="12">Aucun enregistrement trouvé</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Paiement -->
  <div class="modal fade" id="paiementModal" tabindex="-1" role="dialog" aria-labelledby="paiementModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="paiementModalLabel">Encaisser un Paiement</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body">
          <form id="paiementForm">
            <input type="hidden" id="colisId" name="colisId" />

            <!-- Montant Total -->
            <div class="form-group">
              <label>Montant Total :</label>
              <input type="text" class="form-control" id="montantTotal" readonly />
            </div>

            <!-- Montant Déjà Payé -->
            <div class="form-group">
              <label>Montant Déjà Payé :</label>
              <input type="text" class="form-control" id="montantDejaPaye" readonly />
            </div>

            <!-- Remise -->
            <div class="form-group">
              <label>Remise (€)</label>
              <input type="number" class="form-control" id="remise" name="remise" min="0" value="0" />
            </div>

            <!-- Montant Restant -->
            <div class="form-group">
              <label>Montant Restant :</label>
              <input type="text" class="form-control" id="montantRestant" readonly />
            </div>

            <!-- Type de Paiement -->
            <div class="form-group">
              <label>Type de Paiement :</label>
              <select class="form-control" id="typePaiement" required>
                <option value="total">Paiement Total</option>
                <option value="partiel">Paiement Partiel</option>
              </select>
            </div>

            <!-- Montant Partiel -->
            <div class="form-group" id="montantPartielDiv" style="display: none;">
              <label>Montant Payé :</label>
              <input type="number" class="form-control" id="montantPartiel" step="0.01" />
            </div>

            <button type="submit" class="btn btn-primary">Encaisser</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  <div id="addArticleModal" class="modal fade" role="dialog">
    <div class="modal-dialog modal-lg">
      <!-- Large modal -->
      <div class="modal-content">
        <div class="modal-header">
          <h4 class="modal-title">Ajouter un article</h4>
          <button type="button" class="close" data-dismiss="modal">&times;</button>
        </div>
        <div class="modal-body">
          <form id="addArticleForm">
            <input type="hidden" id="colisUrl" name="colisUrl" />

            <div class="form-group">
              <label for="typeMarchandises">Type de Marchandise</label>
              <select class="form-control select2" id="typeMarchandises" name="typeMarchandises">
                <option value="">Sélectionner</option>
                {% for type in typeMarchandises %}
                  <option value="{{ type.nom }}">{{ type.nom }}</option>
                {% endfor %}
              </select>
            </div>

            <div class="form-group">
              <label for="poidsVolume">Couleur</label>
              <input type="color" class="form-control" id="poidsVolume" name="poidsVolume" required />
            </div>

            <div class="form-group">
              <label for="prixPoidsVolume">Prix</label>
              <input type="number" class="form-control" id="prixPoidsVolume" name="prixPoidsVolume" required />
            </div>

            <div class="form-group">
              <label for="observations">Observations</label>
              <textarea class="form-control" id="observations" name="observations"></textarea>
            </div>

            <div class="form-group">
              <label for="photo">Photo (Optionnel)</label>
              <input type="file" class="form-control" id="photo" name="photo" />
            </div>

            <button type="submit" class="btn btn-success">Ajouter</button>
          </form>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
{% block javascripts %}
  <script type="text/javascript" src="{{ domaine }}/assets/js/base-colis.js"></script>
  <script type="text/javascript" src="{{ domaine }}/assets/js/jquery.dataTables.min.js"></script>
  <script type="text/javascript" src="{{ domaine }}/assets/js/dataTables.bootstrap4.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.delete-colis-btn').forEach((button) => {
        button.addEventListener('click', function () {
          const colisId = this.getAttribute('data-id')
          if (confirm('Êtes-vous sûr de vouloir supprimer ce colis ?')) {
            fetch(`/ramassages/colis/supprimer/${colisId}`, {
              method: 'DELETE',
              headers: {
                'X-Requested-With': 'XMLHttpRequest'
              }
            })
              .then((response) => response.json())
              .then((data) => {
                if (data.success) {
                  alert('Colis supprimé avec succès !')
                  location.reload()
                } else {
                  alert('Erreur lors de la suppression.')
                }
              })
              .catch((error) => {
                console.error('Erreur:', error)
                alert('Une erreur est survenue.')
              })
          }
        })
      })
    })
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      // Ouvrir le modal et remplir les champs
      document.querySelectorAll('.add-article-btn').forEach((button) => {
        button.addEventListener('click', function () {
          const colisId = this.getAttribute('data-url')
          document.getElementById('colisUrl').value = colisId
          $('#addArticleModal').modal('show')
        })
      })
    
      // Gestion de l'ajout d'un article via AJAX
      document.getElementById('addArticleForm').addEventListener('submit', function (e) {
        e.preventDefault()
        let formData = new FormData(this)
    
        fetch('/ramassages/colis/addArticle', {
          method: 'POST',
          body: formData
        })
          .then((response) => response.json())
          .then((data) => {
            alert(data.message)
            $('#addArticleModal').modal('hide')
            //  location.reload() // Rafraîchir la page pour voir les changements
          })
          .catch((error) => {
            console.error('Erreur:', error)
            alert('Une erreur est survenue.')
          })
      })
    })
    $('.select2').select2()
  </script>
  <script>
    $(document).ready(function () {
      $('.delete-paiement').click(function () {
        let paiementId = $(this).data('id')
    
        if (confirm('Êtes-vous sûr de vouloir supprimer ce paiement ? Cette action est irréversible.')) {
          $.ajax({
            url: '/ramassages/paiements/delete/' + paiementId,
            type: 'POST',
            dataType: 'json',
            success: function (response) {
              if (response.success) {
                $('#paiement-row-' + paiementId).fadeOut(500, function () {
                  $(this).remove()
                })
                alert('Success: Paiement réitialisé ')
                location.reload()
              } else {
                alert('Erreur : ' + response.error)
              }
            },
            error: function (xhr) {
              alert('Une erreur est survenue. Réessayez plus tard.')
            }
          })
        }
      })
    })
  </script>
{% endblock %}
