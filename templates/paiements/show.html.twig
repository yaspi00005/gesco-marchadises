{% extends 'base.html.twig' %}

{% block title %}Paiements{% endblock %}

{% block body %}
    <h1>Paiements</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ paiement.id }}</td>
            </tr>
            <tr>
                <th>Montants</th>
                <td>{{ paiement.montants }}</td>
            </tr>
            <tr>
                <th>DateReception</th>
                <td>{{ paiement.dateReception ? paiement.dateReception|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>ModePaiement</th>
                <td>{{ paiement.modePaiement }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_paiements_index') }}">back to list</a>

    <a href="{{ path('app_paiements_edit', {'id': paiement.id}) }}">edit</a>

    {{ include('paiements/_delete_form.html.twig') }}
{% endblock %}
