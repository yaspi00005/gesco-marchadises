<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0" />
    <link rel="shortcut icon" type="image/x-icon" href="assets/img/favicon.png" />
    <title>Gestion</title>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700,900" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="assets/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="assets/plugins/fontawesome/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="assets/plugins/fontawesome/css/fontawesome.min.css" />
    <link rel="stylesheet" type="text/css" href="assets/css/style.css" />
    <!--  [if lt IE 9]>
		<script src="assets/js/html5shiv.min.js"></script>
		<script src="assets/js/respond.min.js"></script>
	<![endif]  -->
  </head>

  <body>
    <div class="main-wrapper">
      <div class="account-page">
        <div class="container">
          <h3 class="account-title text-white">
            {% if app.request.cookies.get('nom') %}
              {{ app.request.cookies.get('nom') }}
            {% else %}
              AIR CARGO
            {% endif %}
          </h3>
          <div class="account-box">
            <div class="account-wrapper">
              <div class="account-logo">
                <a href=""><img src="assets/img/logo.jpg" alt="GescoFlex" /></a>
              </div>
              {{ form_start(registrationForm) }}
                {% if app.user %}
                  <div class="mb-3">
                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
                  </div>
                {% endif %}
                <div class="form-group custom-mt-form-group">
                {{ form_widget(registrationForm.usename) }}
                {{ form_errors(registrationForm.usename) }}
                  <label class="control-label">Numéro de téléphone (WhatsApp) "</label><i class="bar"></i>
                </div>
                <div class="form-group custom-mt-form-group">
                  {{ form_widget(registrationForm.prenom) }}
                    {{ form_errors(registrationForm.prenom) }}
                  <label class="control-label">Prénom</label><i class="bar"></i>
                </div>
                <div class="form-group custom-mt-form-group">
                  {{ form_widget(registrationForm.nom) }}
                    {{ form_errors(registrationForm.nom) }}
                  <label class="control-label">Nom</label><i class="bar"></i>
                </div>
                <div class="form-group custom-mt-form-group">
                   {{ form_widget(registrationForm.email) }}
                     {{ form_errors(registrationForm.email) }}
                  <label class="control-label">Email</label><i class="bar"></i>
                </div>
                <div class="form-group custom-mt-form-group">
    {{ form_widget(registrationForm.plainPassword) }}
    {{ form_errors(registrationForm.plainPassword) }}
    <label class="control-label">Mot de passe</label><i class="bar"></i>
</div>
<div class="form-group custom-mt-form-group">
    {{ form_widget(registrationForm.confirmPassword) }}
    {{ form_errors(registrationForm.confirmPassword) }}
    <label class="control-label">Confirmer le mot de passe</label><i class="bar"></i>
</div>
                 <div class="form-group custom-mt-form-group">
                   {{ form_widget(registrationForm.agreeTerms) }}
                  <label class="control-label">Accepter les conditions</label><i class="bar"></i>
                </div>
                <div class="form-group text-center custom-mt-form-group">
                  <button class="btn btn-primary btn-block account-btn" type="submit">Enregistrer</button>
                </div>
                <div class="form-group text-center custom-mt-form-group">
                  <a href="/" class="">Se connecter</a>
                </div>
               
               {{ form_end(registrationForm) }}
           
          </div>
        </div>
      </div>
    </div>
    <div class="sidebar-overlay" data-reff=""></div>
    <script type="text/javascript" src="assets/js/jquery-3.5.1.min.js"></script>
    <script type="text/javascript" src="assets/js/popper.min.js"></script>
    <script type="text/javascript" src="assets/js/bootstrap.min.js"></script>
    <script type="text/javascript" src="assets/js/jquery.slimscroll.js"></script>
    <script type="text/javascript" src="assets/js/app.js"></script>
  </body>
</html>
