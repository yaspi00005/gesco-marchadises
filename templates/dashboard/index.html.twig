{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" type="text/css" href="{{ domaine }}/assets/plugins/morris/morris.css">
{% endblock %}

{% block body %}
<div class="page-wrapper">
    <div class="content container-fluid">
        <div class="row">
            <!-- Nombre total de clients -->
            <div class="col-md-6 col-sm-6 col-lg-6 col-xl-3">
                <div class="dash-widget dash-widget5">
                    <span class="dash-widget-icon bg-primary"><i class="fa fa-users"></i></span>
                    <div class="dash-widget-info">
                        <h3>{{ totalClients }}</h3>
                        <span>Clients enregistrés</span>
                    </div>
                </div>
            </div>

            <!-- Nombre total de colis -->
            <div class="col-md-6 col-sm-6 col-lg-6 col-xl-3">
                <div class="dash-widget dash-widget5">
                    <span class="dash-widget-icon bg-info"><i class="fa fa-box"></i></span>
                    <div class="dash-widget-info">
                        <h3>{{ totalColis }}</h3>
                        <span>Colis enregistrés</span>
                    </div>
                </div>
            </div>

            <!-- Colis non récupérés -->
            <div class="col-md-6 col-sm-6 col-lg-6 col-xl-3">
                <div class="dash-widget dash-widget5">
                    <span class="dash-widget-icon bg-warning"><i class="fa fa-exclamation-circle"></i></span>
                    <div class="dash-widget-info">
                        <h3>{{ colisNonRecuperes }}</h3>
                        <span>Colis non récupérés</span>
                    </div>
                </div>
            </div>

            <!-- Montant encaissé -->
            <div class="col-md-6 col-sm-6 col-lg-6 col-xl-3">
                <div class="dash-widget dash-widget5">
                    <span class="dash-widget-icon bg-success"><i class="fa fa-money-bill-wave"></i></span>
                    <div class="dash-widget-info">
                        <h3>{{ montantEncaisse|number_format(2, ',', ' ') }} €</h3>
                        <span>Montant encaissé</span>
                    </div>
                </div>
            </div>

            <!-- Montant restant à encaisser -->
            <div class="col-md-6 col-sm-6 col-lg-6 col-xl-3">
                <div class="dash-widget dash-widget5">
                    <span class="dash-widget-icon bg-danger"><i class="fa fa-hand-holding-usd"></i></span>
                    <div class="dash-widget-info">
                        <h3>{{ montantRestant|number_format(2, ',', ' ') }} €</h3>
                        <span>Montant restant</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-lg-12">
                <div class="content-page">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="page-title mb-2">Suivi des Colis</div>
                            <div class="table-responsive">
                                <table class="table table-striped custom-table">
                                    <thead>
                                        <tr>
                                            <th>Période</th>
                                            <th></th>
                                            <th></th>
                                            <th></th>
                                            <th></th>
                                            <th></th>
                                            <th class="text-right">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {# À compléter avec les données des colis si nécessaire #}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
             </div>       
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="{{ domaine }}/assets/js/moment.min.js"></script>
    <script type="text/javascript" src="{{ domaine }}/assets/js/bootstrap-datetimepicker.min.js"></script>
    <script type="text/javascript" src="{{ domaine }}/assets/plugins/morris/morris.min.js"></script>
    <script type="text/javascript" src="{{ domaine }}/assets/plugins/raphael/raphael-min.js"></script>
    <script type="text/javascript" src="{{ domaine }}/assets/js/fullcalendar.min.js"></script>
    <script type="text/javascript" src="{{ domaine }}/assets/js/jquery.fullcalendar.js"></script>
    <script type="text/javascript" src="{{ domaine }}/assets/js/chart.js"></script>
{% endblock %}
