{% extends 'base.html.twig' %}

{% block title %}
  Hello HomeController!
{% endblock %}
{% block stylesheets %}
  <link rel="stylesheet" type="text/css" href="{{ domaine }}/assets/plugins/morris/morris.css" />
{% endblock %}
{% block body %}
  <div class="page-wrapper">
    <!-- content -->
    <div class="content container-fluid">
      <div class="page-header">
        <div class="row">
          <div class="col-lg-7 col-md-12 col-sm-12 col-12">
            <h5 class="text-uppercase">about teacher</h5>
          </div>
          <div class="col-lg-5 col-md-12 col-sm-12 col-12">
            <ul class="list-inline breadcrumb float-right">
              <li class="list-inline-item">
                <a href="#">Home</a>
              </li>
              <li class="list-inline-item">
                <a href="#">Teachers</a>
              </li>
              <li class="list-inline-item">About Teacher</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="content-page">
        <div class="row">
          <div class="col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="aboutprofile-sidebar">
              <div class="row">
                <div class="col-lg-3 col-md-12 col-sm-12 col-12">
                  <div class="aboutprofile">
                    <div class="card">
                      <div class="card-body">
                        <div class="row">
                          <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="aboutprofile-pic">
                              <img class="card-img-top" src="{{ domaine }}/assets/img/user.jpg" alt="Card image" />
                            </div>
                            <div class="aboutprofile-name">
                              <h5 class="text-center mt-2">{{ colis.destinateurs.prenom ~ ' ' ~ colis.destinateurs.nom }}</h5>
                            </div>
                            <ul class="list-group list-group-flush">
                              <li class="list-group-item">
                                <b>Téléphone</b><a href="#" class="float-right">{{ colis.destinateurs.usename }}</a>
                              </li>
                              <li class="list-group-item">
                                <b>Daté d'adhésion</b><a href="#" class="float-right">0</a>
                              </li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-lg-9 col-md-12 col-sm-12 col-12">
                  <div class="profile-content">
                    <div class="row">
                      <div class="col-lg-12">
                        <div class="card">
                          <!-- Nav tabs -->
                          <ul class="nav customtab">
                            <li class="nav-item">
                              <a href="#" class="nav-link active show">Information du colis</a>
                            </li>
                          </ul>

                          <!-- Tab panes -->
                          <div class="tab-content">
                            <div class="tab-pane active show" id="tab1">
                              <div id="biography" class="biography">
                                <div class="row">
                                  <div class="col-md-3 col-6">
                                    <strong>Numéro de suivi</strong>
                                    <br />
                                    <p class="text-muted">{{ colis.numeroSuivi }}</p>
                                  </div>
                                  <div class="col-md-3 col-6">
                                    <strong>Type d'expédition</strong>
                                    <br />
                                    <p class="text-muted">{{ colis.typeExpeditions }}</p>
                                  </div>
                                  <div class="col-md-3 col-6">
                                    <strong>Poids total</strong>
                                    <br />
                                    <p class="text-muted">{{ colis.poidsVolumeTotal }} kg</p>
                                  </div>
                                  <div class="col-md-3 col-6">
                                    <strong>Prix</strong>
                                    <br />
                                    <p class="text-muted">{{ colis.fraisExpeditions|number_format(0, '.', ',') }} FCFA</p>
                                  </div>
                                </div>
                                <div class="row mt-3">
                                  <div class="col-md-3 col-6">
                                    <strong>Statut</strong>
                                    <br />
                                    <p class="text-muted">
                                      {# <span class="badge 
                                          {% if colis.statut == 'En Préparation' %}

                                        {% elseif colis.statut == 'Expédié' %}

                                        {% elseif colis.statut == 'Livré' %}

                                        {% elseif colis.statut == 'Annulé' %}

                                        {% endif %}">
                                        {{ colis.statut }}
                                      </span> #}
                                    </p>
                                  </div>
                                  <div class="col-md-3 col-6">
                                    <strong>Date de réception</strong>
                                    <br />
                                    <p class="text-muted">{{ colis.dateReceptions ? colis.dateReceptions|date('d-m-Y') : 'Non reçu' }}</p>
                                  </div>
                                  <div class="col-md-3 col-6">
                                    <strong>Date de récupération</strong>
                                    <br />
                                    <p class="text-muted">{{ colis.dateRecuperations ? colis.dateRecuperations|date('d-m-Y') : 'Non récupéré' }}</p>
                                  </div>
                                  <div class="col-md-3 col-6">
                                    <strong>Mode de transport</strong>
                                    <br />
                                    <p class="text-muted">{{ colis.expeditions.modeTransport }}</p>
                                  </div>
                                </div>
                                <div class="row mt-3">
                                  <div class="col-md-6 col-12">
                                    <strong>Destinateur</strong>
                                    <br />
                                    <p class="text-muted">{{ colis.destinateurs.prenom ~ ' ' ~ colis.destinateurs.nom }}</p>
                                  </div>
                                  <div class="col-md-6 col-12">
                                    <strong>Numéro d'expédition</strong>
                                    <br />
                                    <p class="text-muted">
                                      <a href="#">{{ colis.expeditions.numeroExpeditions }}</a>
                                    </p>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="row">
                        {% for colis in colis.baseColisDetails %}
                          <div class="col-md-12">
                            <div class="blog-view">
                              <article class="blog blog-single-post">
                                <h3 class="blog-title">{{ colis.typeMarchandises }}</h3>
                                <div class="blog-info clearfix">
                                <div class="table-responsive">
                                  <table class="table table-striped custom-table">
                                    
                                    <tbody>
                                      <tr>
                                        <th>Poids</th>
                                        <td>{{ colis.poidsVolume }}</td>
                                        <th>Prix unitaire</th>
                                        <td>{{ colis.prixPoidsVolume|number_format(0, '.', ',') }}</td>
                                        <th>Total</th>
                                        <td>{{ colis.montantTotal|number_format(0, '.', ',') }}</td>
                                      </tr> 
                                    </tbody>
                                  </table>
                                  
                                </div>
                                <div class="blog-image">
                                  <a href="#"><img src="{{ colis.photo ? asset('uploads/' ~ colis.photo) : asset('images/default-package.jpg') }}" class="card-img-top" alt="Image du colis" /></a>
                                </div>
                              </article>
                            </div>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
{% block javascripts %}
  <script type="text/javascript" src="{{ domaine }}/assets/js/moment.min.js"></script>
  <script type="text/javascript" src="{{ domaine }}/assets/js/bootstrap-datetimepicker.min.js"></script>
  <script type="text/javascript" src="{{ domaine }}/assets/plugins/morris/morris.min.js"></script>
  <script type="text/javascript" src="{{ domaine }}/assets/plugins/raphael/raphael-min.js"></script>
  <script type="text/javascript" src="{{ domaine }}/assets/js/fullcalendar.min.js"></script>
  <script type="text/javascript" src="{{ domaine }}/assets/js/jquery.fullcalendar.js"></script>
  <script type="text/javascript" src="{{ domaine }}/assets/js/chart.js"></script>
{% endblock %}
