<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fiche Client</title>
    <style>
      body {
        font-family: Arial, sans-serif;
      }
      .container {
        border: 1px solid #000;
        padding: 20px;
        width: 300px;
        text-align: left;
      }
      .logo {
        width: 100px;
        display: block;
        margin: 0 auto;
      }
      .transitaire-info {
        text-align: center;
      }
      .transitaire-info p {
        margin: 5px 0;
      }
      .client-info,
      .delivery-address {
        margin-top: 20px;
      }
      .qr-code {
        margin: 15px auto;
        width: 100px;
      }
      .warning {
        margin-top: 15px;
        font-size: 10px;
        color: red;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- Entête : Informations du Transitaire -->
      <div class="transitaire-info">
        <img src="{{ asset('assets/img/logo_.jpeg') }}" alt="Logo" class="logo" />
        <p>
          <strong>{{ transitaire.nom }}</strong>
        </p>
        <p>{{ transitaire.infos }}</p>
        <p>
          <strong>Téléphone Chine :</strong> {{ transitaire.telephone_chine }}
        </p>
        <p>
          <strong>Téléphone Mali :</strong> {{ transitaire.telephone_mali }}
        </p>
      </div>

      <!-- Informations du Client -->
      <div class="client-info">
        <p>
          <strong>Nom :</strong>{{ client.nom }}
        </p>
        <p>
          <strong>Prénom :</strong>{{ client.prenom }}
        </p>
        <p>
          <strong>Téléphone :</strong>{{ client.usename }}
        </p>
        <img src="{{ asset('uploads/') }}{{ client.qrCodePath }}" alt="QR Code" class="qr-code" />
      </div>

      <!-- Adresse de Livraison en Chine -->
      <div class="delivery-address">
        <p>
          <strong>Adresse de Livraison (Chine) :</strong> {{ transitaire.adresse_chine }}
        </p>
      </div>

      <!-- Avertissement pour l'emballage -->
      <div class="warning">
        <p>
          <strong>Avertissement :</strong>{{ transitaire.warning }}
        </p>
      </div>
    </div>
  </body>
</html>
